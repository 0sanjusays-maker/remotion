{
	"name": "golden-arghya",
	"version": "1.0.0",
	"private": true,
	"description": "The Golden Arghya - a 72 second cinematic Chhath Puja film built with Remotion",
	"scripts": {
		"dev": "vite --host 0.0.0.0 --port 3000",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0 --port 3000",
		"studio": "remotion studio --no-open",
		"compositions": "remotion compositions",
		"render": "remotion render GoldenArghya out/golden-arghya.mp4 --pixel-format=yuv420p --codec=h264 --audio-codec=aac --crf=20",
		"still": "remotion still GoldenArghya out/still.png",
		"audio": "node scripts/build-audio.mjs"
	},
	"dependencies": {
		"@fontsource/noto-serif-devanagari": "5.2.5",
		"@fontsource/tiro-devanagari-hindi": "5.2.5",
		"@remotion/cli": "4.0.543",
		"@remotion/player": "4.0.543",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"remotion": "4.0.543"
	},
	"devDependencies": {
		"@types/react": "19.1.8",
		"@types/react-dom": "19.1.6",
		"@vitejs/plugin-react": "4.3.4",
		"typescript": "5.7.3",
		"vite": "6.0.11"
	}
}
